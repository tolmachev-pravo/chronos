# Copy to .env next to docker-compose.yml. Compose reads it to fill in the compose file.

# Image version to run, without the leading "v". The Deploy to Docker workflow rewrites
# this line on every deployment.
CHRONOS_TAG=latest

# Address and port on the host the app answers on directly. 127.0.0.1 keeps it reachable
# only from the host itself; use 0.0.0.0 to expose it.
CHRONOS_BIND=127.0.0.1
CHRONOS_PORT=8080

# Server time zone: the app reads "now" in it.
TZ=Europe/Moscow

# Behind the shared Traefik from deploy/edge (see README.md): uncomment both lines.
# COMPOSE_FILE=docker-compose.yml:docker-compose.edge.yml
# CHRONOS_HOST=chronos.example.com
