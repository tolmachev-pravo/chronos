# Optional. Copy to chronos.env next to docker-compose.yml to override application settings
# from appsettings.json. Nested keys use a double underscore: Jira:Url -> Jira__Url.
# The file is passed to the container as is, so keep secrets here, not in .env.

# Jira__Url=https://jira.example.org/
# Mcp__Enabled=false
# Serilog__MinimumLevel__Default=Information
