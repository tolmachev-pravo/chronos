@using Chronos.Web.Components.Common

<div class="rel-page">
    @if (_isLoading)
    {
        <div class="rel-list">
            @for (var i = 0; i < 3; i++)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="180px" Class="rel-page__skeleton" />
            }
        </div>
    }
    else if (_result.Releases.Count > 0)
    {
        <div class="rel-list">
            @foreach (var release in _result.Releases)
            {
                <ReleaseCard Release="release" />
            }
        </div>
    }
    else if (_result.LoadFailed)
    {
        <div class="rel-error">
            <MudIcon Icon="@Icons.Material.Outlined.CloudOff" Class="rel-error__icon" />
            <MudText Typo="Typo.h6" Class="rel-error__title">Не удалось загрузить релизы</MudText>
            <MudText Typo="Typo.body2" Class="rel-error__text">
                Похоже, GitHub сейчас недоступен из приложения.
                Вы можете посмотреть релизы напрямую на GitHub.
            </MudText>
            <MudButton Href="@_result.ReleasesUrl" Target="_blank"
                       Variant="Variant.Filled" Color="Color.Primary"
                       EndIcon="@Icons.Material.Filled.OpenInNew" Class="mt-2">
                Открыть релизы на GitHub
            </MudButton>
        </div>
    }
    else
    {
        <Stub Message="Релизов пока нет. Загляните позже!" />
    }
</div>
