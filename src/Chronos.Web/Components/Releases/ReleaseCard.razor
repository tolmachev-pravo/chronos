@using Chronos.Web.Components.Markdown

<div class="rel-card">
    <div class="rel-card__head">
        <div class="rel-card__title-group">
            <MudText Typo="Typo.h6" Class="rel-card__title" Style="font-weight:700">@Release.Title</MudText>
            <div class="rel-card__tag">
                <MudIcon Icon="@Icons.Material.Outlined.Sell" Size="Size.Small" Class="rel-card__tag-icon" />
                @Release.TagName
            </div>
        </div>

        @if (Release.IsPrerelease)
        {
            <div class="extv-glow__status extv-glow__status--soon rel-card__badge">
                <span class="extv-glow__led"></span>
                Pre-release
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Release.BodyMarkdown))
    {
        <div class="rel-card__body mt-3">
            <MudMarkdown Value="@Release.BodyMarkdown" />
        </div>
    }
    else
    {
        <MudText Typo="Typo.body2" Class="mt-3" Style="opacity:.6">Описание отсутствует.</MudText>
    }

    <div class="rel-card__foot mt-4">
        @if (Release.PublishedAt.HasValue)
        {
            <span class="rel-card__date">
                <MudIcon Icon="@Icons.Material.Outlined.CalendarToday" Size="Size.Small" Class="rel-card__date-icon" />
                @Release.PublishedAt.Value.ToLocalTime().ToString("dd.MM.yyyy")
            </span>
        }

        @if (!string.IsNullOrWhiteSpace(Release.HtmlUrl))
        {
            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                       Href="@Release.HtmlUrl" Target="_blank"
                       EndIcon="@Icons.Material.Filled.OpenInNew">
                Открыть на GitHub
            </MudButton>
        }
    </div>
</div>
