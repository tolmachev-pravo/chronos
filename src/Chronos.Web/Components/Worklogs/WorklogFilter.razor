@using Chronos.Web.Components.Markdown

<style>
    .chr-full-width {
        width: 100% !important;
    }
</style>

<MudPaper Class="flex-none pa-4" Square="true" Outlined="true">
    <MarkdownTooltip Markdown="worklog-filter-date-range" RootClass="chr-full-width">
        <MudDateRangePicker Label="Date range" @bind-DateRange="_model.Filter.DateRange"
                            FirstDayOfWeek="DayOfWeek.Monday" />
    </MarkdownTooltip>
    @* The working day moved to the profile (issue #241): it is the same for every search,
       so the panel only asks for the period. *@
</MudPaper>

<MudButton OnClick="Search" Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.Send" Class="mt-2">Search</MudButton>
@code {
    }
