@page "/"
@page "/worklogs"
@using Chronos.Web.Components.Features
@using Chronos.Web.Components.Worklogs.Summary

@* One frame for every state: the period column on the left, the days on the right.
   Only what the frame holds changes, so starting, running and finishing a search never
   rearranges the page. News takes the right side while it has nothing else to show and
   shrinks to a chip above the days once they are there. *@
<div class="chr-worklog-page mb-4">
    <aside class="chr-worklog-page__side">
        <WorklogPeriodPanel Selected="_selected" Loaded="_loadedLog?.Period" Days="_items" Log="StatusLog"
                            IsLoading="IsLoading" Settings="_settings"
                            OnSelect="Select" OnShow="ShowAsync" OnCancel="Cancel" />
    </aside>

    <div class="chr-worklog-page__main">
        @if (IsLoading || _loadedLog is not null)
        {
            <div class="d-flex align-center mb-2">
                @if (!IsLoading)
                {
                    @* Quiet on purpose: the days are what the page is about, the switch is a way
                       to look at them. *@
                    <MudToggleGroup T="WorklogView" @bind-Value="_view" Size="Size.Small" Outlined="false" Delimiters="false"
                                    Color="Color.Default" CheckMark="false" SelectedClass="chr-segmented__on" Class="chr-segmented">
                        <MudToggleItem Value="WorklogView.List" title="Ворклоги" aria-label="Ворклоги">
                            <MudIcon Icon="@Icons.Material.Outlined.ViewList" Size="Size.Small" />
                        </MudToggleItem>
                        <MudToggleItem Value="WorklogView.Summary" title="Сводка" aria-label="Сводка">
                            <MudIcon Icon="@Icons.Material.Outlined.Insights" Size="Size.Small" />
                        </MudToggleItem>
                    </MudToggleGroup>
                }
                <MudSpacer />
                <LatestFeaturesViewer Inline="true" />
            </div>
        }
        @if (!IsLoading && _loadedLog is not null && _view == WorklogView.Summary)
        {
            <WorklogSummaryView Days="@_items" Period="_loadedLog.Period" />
        }
        else
        {
            <MudPaper Outlined="true">
                @if (IsLoading)
                {
                    <WorklogSkeleton Period="_loadingLog.Period" Settings="_settings" />
                }
                else if (_loadedLog is not null)
                {
                    <WorklogList Items="@_items" OnDayChanged="DayChanged" />
                }
                else
                {
                    <div class="pa-4">
                        <LatestFeaturesViewer FallbackMessage="Выберите период слева и нажмите «Показать» — Chronos соберёт ворклоги и предложения по нему." />
                    </div>
                }
            </MudPaper>
        }
    </div>
</div>
