@using Chronos.Application.Users.Dto
@* The working day from the profile, with its norm: the number every day of the result
   is measured against (issue #241). The hours on one line, what they hold on the next. *@
<div class="d-flex align-start gap-2 chr-working-day">
    <MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" />
    <div class="flex-1">
        <div class="d-flex align-center">
            <span class="chr-working-day__hours">@WorkingDayFormat.Hours(Settings)</span>
            <MudSpacer />
            <MudLink Href="/profile" Typo="Typo.caption">Изменить</MudLink>
        </div>
        <div>@WorkingDayFormat.LunchAndNorm(Settings)</div>
    </div>
</div>

@code {
    [Parameter] public UserSettingsDto Settings { get; set; } = UserSettingsDto.Default;
}
