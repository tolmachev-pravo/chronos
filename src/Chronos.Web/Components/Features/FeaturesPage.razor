@using Chronos.Web.Components.Common

<div class="feat-page">
    <div class="chr-section-head">
        <MudText Typo="Typo.h5" Style="font-weight:700">Features</MudText>
        <MudText Typo="Typo.body2" Style="opacity:.6" Class="mt-1">
            Свежие возможности приложения — что нового и как этим пользоваться.
        </MudText>
    </div>

    @if (_isLoading)
    {
        <div class="feat-catalog mt-5">
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="260px" Class="feat-page__skeleton" />
            <div class="extv-glow__grid">
                @for (var i = 0; i < 3; i++)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="330px" Class="feat-page__skeleton" />
                }
            </div>
        </div>
    }
    else if (_hero is null)
    {
        <Stub Message="Новинок пока нет. Загляните позже!" />
    }
    else
    {
        <div class="feat-catalog mt-5">
            <FeatureHero Feature="_hero" />

            @if (_rest.Count > 0)
            {
                <MudCarousel TData="object"
                             Class="feat-carousel"
                             Style="@CarouselStyle"
                             ShowArrows="@ShowOverlayControls"
                             ShowBullets="@ShowOverlayControls"
                             BulletsColor="Color.Primary"
                             EnableSwipeGesture="true"
                             AutoCycle="false"
                             @bind-SelectedIndex="_page">
                    @foreach (var page in Pages)
                    {
                        <MudCarouselItem Transition="Transition.Slide">
                            <div class="extv-glow__grid feat-carousel__page @(_columns == 1 ? "feat-carousel__page--single" : null)">
                                @foreach (var feature in page)
                                {
                                    <FeatureCard Feature="feature" />
                                }
                            </div>
                        </MudCarouselItem>
                    }
                </MudCarousel>

                @if (ShowCounter)
                {
                    <div class="feat-carousel__nav">
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                       Size="Size.Small"
                                       aria-label="Предыдущая статья"
                                       Disabled="@(_page == 0)"
                                       OnClick="ShowPreviousPage" />
                        <span class="feat-carousel__counter">@(_page + 1) / @PageCount</span>
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                       Size="Size.Small"
                                       aria-label="Следующая статья"
                                       Disabled="@(_page == PageCount - 1)"
                                       OnClick="ShowNextPage" />
                    </div>
                }
            }
        </div>
    }
</div>
