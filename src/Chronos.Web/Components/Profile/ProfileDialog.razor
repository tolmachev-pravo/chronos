@using Chronos.Web.Components.Markdown

<MudDialog>
    <DialogContent>

        <div class="prd-header">
            <MudAvatar Size="Size.Large" Color="Color.Primary">
                @if (!string.IsNullOrEmpty(Avatar))
                {
                    <img src="@Avatar" alt="avatar" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Rounded.AccountCircle" />
                }
            </MudAvatar>
            <div>
                <MudText Typo="Typo.h6" Style="font-weight:700;line-height:1.2">@Username</MudText>
                <MudText Typo="Typo.caption" Style="opacity:.55">Профиль · рабочий день</MudText>
            </div>
        </div>

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.caption" Style="opacity:.6" Class="mb-4 d-block">
            Рабочий день — это рамка, в которую укладываются предполагаемые ворклоги, и норма
            времени на день. Настройки задаются один раз и применяются к каждому поиску
            в разделе Worklogs.
        </MudText>

        <div class="prd-pickers">
            <MarkdownTooltip Markdown="profile-working-start-time" RootClass="prd-picker">
                <MudTimePicker Label="Начало рабочего дня" @bind-Time="_workingStartTime" Editable="true" />
            </MarkdownTooltip>
            <MarkdownTooltip Markdown="profile-working-end-time" RootClass="prd-picker">
                <MudTimePicker Label="Окончание рабочего дня" @bind-Time="_workingEndTime" Editable="true" />
            </MarkdownTooltip>
            <MarkdownTooltip Markdown="profile-lunch-time" RootClass="prd-picker">
                <MudTimePicker Label="Обед" @bind-Time="_lunchTime" Editable="true" />
            </MarkdownTooltip>
        </div>

        @if (ValidationError is null)
        {
            <MudText Typo="Typo.caption" Style="opacity:.65" Class="mt-4 d-block">
                Рабочее время в день: <b>@WorkingTimeDisplay</b>
            </MudText>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-4">@ValidationError</MudAlert>
        }

    </DialogContent>

    <DialogActions>
        <MudSpacer />
        <MudButton OnClick="Cancel" Variant="Variant.Text">Отмена</MudButton>
        <MudButton OnClick="Save"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(ValidationError is not null)"
                   StartIcon="@Icons.Material.Filled.Check">
            Сохранить
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .prd-header {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .prd-pickers {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
    }

    .prd-picker {
        flex: 1 1 150px;
        min-width: 150px;
    }
</style>
