@page "/"
@namespace Chronos.Web.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Chronos</title>
    <base href="~/" />
    @* asp-append-version stamps a content hash onto the URL of every asset we own, so a
       changed stylesheet or icon reaches users on the next load. Static files are served
       without a Cache-Control header (ETag and Last-Modified only), which leaves browsers
       free to reuse a long-cached copy without revalidating — a rebrand can otherwise stay
       invisible on machines that already have the old CSS. Not applied to the Google Fonts
       and _content/ assets: those are not ours to fingerprint. *@
    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" asp-append-version="true" />
    <link href="css/site.css" rel="stylesheet" asp-append-version="true" />
    <link href="css/custom.css" rel="stylesheet" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="_content/MudBlazor.Markdown/MudBlazor.Markdown.min.css" rel="stylesheet" />

    @* The SVG icon is listed first: browsers that support it prefer it and scale it cleanly,
       the PNGs stay as the fallback. All of them are rasterised from favicon.svg. *@
    <link rel="icon" type="image/svg+xml" href="/images/favicon/favicon.svg" asp-append-version="true">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon/apple-touch-icon.png" asp-append-version="true">
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon/favicon-32x32.png" asp-append-version="true">
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon/favicon-16x16.png" asp-append-version="true">
    <link rel="manifest" href="/images/favicon/site.webmanifest" asp-append-version="true">
    <link rel="mask-icon" href="/images/favicon/safari-pinned-tab.svg" color="#594AE2" asp-append-version="true">
    @* Brand purple, matching the AppBar. The previous values (#5bbad5, #da532c) were
       leftovers from the icon generator and belonged to no palette the app uses. *@
    <meta name="msapplication-TileColor" content="#594AE2">
    <meta name="theme-color" content="#594AE2">
</head>
<body>
    <app>
        <component type="typeof(App)" render-mode="ServerPrerendered" />
    </app>

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            An unhandled exception has occurred. See browser dev tools for details.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    @* Our reconnection handler (scripts/reconnect.js) toggles the components-reconnect-*
       classes on this element and fills the attempt counters; styling in css/custom.css
       keys off those classes. *@
    <div id="components-reconnect-modal">
        <div class="chr-rc__dialog" role="alertdialog" aria-live="assertive">
            <div class="chr-rc__state chr-rc__state--show">
                <div class="chr-rc__spinner" aria-hidden="true"></div>
                <h2 class="chr-rc__title">Соединение потеряно</h2>
                <p class="chr-rc__text">
                    Восстанавливаем связь с сервером…
                    <span class="chr-rc__attempt">
                        Попытка <span id="components-reconnect-current-attempt">1</span>
                        из <span id="components-reconnect-max-retries">12</span>
                        @* aria-hidden: this ticks every second, and the dialog is an assertive
                           live region — a screen reader would read the countdown out loud. *@
                        <span class="chr-rc__next" id="chr-rc-next-attempt" aria-hidden="true"></span>
                    </span>
                </p>
            </div>
            @* Retries exhausted, but the server never answered — offer another round before
               giving up on the page state. *@
            <div class="chr-rc__state chr-rc__state--failed">
                <div class="chr-rc__icon" aria-hidden="true">⚠</div>
                <h2 class="chr-rc__title">Сервер не отвечает</h2>
                <p class="chr-rc__text">
                    Мы несколько минут пытались восстановить связь и не смогли.
                    Можно попробовать ещё раз — состояние страницы пока не потеряно.
                </p>
                <div class="chr-rc__actions">
                    <button type="button" class="chr-rc__btn chr-rc__btn--retry">
                        Повторить
                    </button>
                    <button type="button" class="chr-rc__btn chr-rc__btn--ghost" onclick="location.reload()">
                        Перезагрузить страницу
                    </button>
                </div>
            </div>
            @* The server explicitly dropped the circuit: the state is gone, retrying cannot
               bring it back, so a reload is the only way out. *@
            <div class="chr-rc__state chr-rc__state--rejected">
                <div class="chr-rc__icon" aria-hidden="true">↻</div>
                <h2 class="chr-rc__title">Не удалось восстановить соединение</h2>
                <p class="chr-rc__text">
                    Сервер уже освободил состояние страницы, восстанавливать нечего.
                    Перезагрузите страницу, чтобы продолжить работу.
                </p>
                <button type="button" class="chr-rc__btn" onclick="location.reload()">
                    Перезагрузить страницу
                </button>
            </div>
        </div>
    </div>

    @* Explicit start, so scripts/reconnect.js can install its own reconnection policy —
       the framework default gives up too early for the short drops our users see (issue #285).
       If that file is missing or broke, chronosReconnect is undefined and we start with the
       framework defaults rather than leaving the page without a circuit. *@
    <script src="_framework/blazor.server.js" autostart="false"></script>
    <script src="scripts/reconnect.js" asp-append-version="true"></script>
    <script>
        Blazor.start(window.chronosReconnect ? { reconnectionHandler: window.chronosReconnect.handler } : {});
    </script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="_content/MudBlazor.Markdown/MudBlazor.Markdown.min.js"></script>
    <script src="scripts/clipboard.js"></script>
</body>
</html>
